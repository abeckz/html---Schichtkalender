{
  "name": "schichtkalender",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Jahres-Schichtkalender mit A3-Duplexdruck",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:offline": "node scripts/buildOffline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:theme": "node scripts/checkTheme.mjs BASF-Schichtkalender.html",
    "check:print": "node scripts/checkPrintPdf.mjs BASF-Schichtkalender.html"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  }
}
